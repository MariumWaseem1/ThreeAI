# Supabase — https://supabase.com (create a free project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — https://resend.com
RESEND_API_KEY=re_xxxx

# AI — Claude fallback (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxx

# AI — Groq primary, free tier (https://console.groq.com)
GROQ_API_KEY=gsk_xxxx

# NewsAPI — free tier, 100 req/day (https://newsapi.org)
NEWSAPI_KEY=your-newsapi-key

# Reddit API — for reliable Reddit access (https://www.reddit.com/prefs/apps)
# Create a "script" app, use the ID and secret below
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# Your deployed URL (update after first deploy)
NEXT_PUBLIC_BASE_URL=https://signal-newsletter.onrender.com

# Cron job auth — any random string
CRON_SECRET=any-random-string-here
